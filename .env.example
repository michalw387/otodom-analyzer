# Copy to .env and fill in. Values entered in the app's settings take precedence.
#
# AI scoring uses your locally installed, logged-in Claude Code (`claude auth login`) –
# no API key is needed. ANTHROPIC_API_KEY is ignored and never passed to Claude Code.

# Optional: path to the Claude Code executable when `claude` is not on the PATH of the app
# CLAUDE_CLI_PATH=/home/you/.local/bin/claude

# Notifications (optional) – used when the corresponding field in the app is empty.
# ntfy:    NOTIFY_WEBHOOK_URL=https://ntfy.sh/your-hard-to-guess-topic
# Discord: NOTIFY_WEBHOOK_URL=https://discord.com/api/webhooks/...
NOTIFY_WEBHOOK_URL=
# Telegram: bot token from @BotFather and your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: custom database location (default: data/otodom.db)
# OTODOM_DB_PATH=/path/to/otodom.db
